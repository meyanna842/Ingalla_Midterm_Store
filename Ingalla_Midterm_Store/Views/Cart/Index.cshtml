@model List<Ingalla_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    decimal total = Model.Sum(item => item.Price * item.Quantity);
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Shopping Cart</h1>
        <p class="text-muted">
            Review your selected products.
        </p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-primary">
            Browse Products
        </a>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@item.ProductName</strong>
                                </td>

                                <td>
                                    ₱@item.Price.ToString("N2")
                                </td>

                                <td>

                                    <form asp-action="UpdateQuantity"
                                          method="post"
                                          class="d-flex gap-2">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <input type="number"
                                               name="quantity"
                                               value="@item.Quantity"
                                               min="1"
                                               class="form-control"
                                               style="width: 80px;" />

                                        <button type="submit"
                                                class="btn btn-outline-primary">
                                            Update
                                        </button>

                                    </form>

                                </td>

                                <td>
                                    ₱@((item.Price * item.Quantity).ToString("N2"))
                                </td>

                                <td>

                                    <a asp-action="Remove"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm"
                                       onclick="return confirm('Remove this item?')">
                                        Remove
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="card-body border-top">

                <div class="d-flex justify-content-between align-items-center">

                    <h4 class="fw-bold mb-0">
                        Total
                    </h4>

                    <h3 class="fw-bold mb-0">
                        ₱@total.ToString("N2")
                    </h3>

                </div>

            </div>

        </div>

        <div class="mt-3">

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Continue Shopping
            </a>

        </div>
    }

</div>